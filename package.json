{
  "name": "ipynb-pdf-converter",
  "displayName": "Ipynb PDF Converter",
  "description": "%description%",
  "version": "0.9.1",
  "publisher": "leekh",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekh4232/ipynb-to-pdf-converter"
  },
  "homepage": "https://ipynb-to-pdf.hossam.kr/",
  "author": {
    "name": "이광호",
    "email": "leekh4232@gmail.com"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ipynb-pdf-converter.convertToPdf",
        "title": "%cmd.convertToPdf.title%",
        "category": "Jupyter"
      },
      {
        "command": "ipynb-pdf-converter.convertToPdfWithPassword",
        "title": "%cmd.convertToPdfWithPassword.title%",
        "category": "Jupyter"
      },
      {
        "command": "ipynb-pdf-converter.convertToPdfHossam",
        "title": "%cmd.convertToPdfHossam.title%",
        "category": "Jupyter"
      },
      {
        "command": "ipynb-pdf-converter.convertToPdfHossamWithPassword",
        "title": "%cmd.convertToPdfHossamWithPassword.title%",
        "category": "Jupyter"
      },
      {
        "command": "ipynb-pdf-converter.convertToPdfJussam",
        "title": "%cmd.convertToPdfJussam.title%",
        "category": "Jupyter"
      },
      {
        "command": "ipynb-pdf-converter.convertToPdfJussamWithPassword",
        "title": "%cmd.convertToPdfJussamWithPassword.title%",
        "category": "Jupyter"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ipynb-pdf-converter.convertToPdf",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@98"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfWithPassword",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@99"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfHossam",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@100"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfHossamWithPassword",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@101"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfJussam",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@102"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfJussamWithPassword",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@103"
        }
      ],
      "editor/title/context": [
        {
          "command": "ipynb-pdf-converter.convertToPdf",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@98"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfWithPassword",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@99"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfHossam",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@100"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfHossamWithPassword",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@101"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfJussam",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@102"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfJussamWithPassword",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@103"
        }
      ],
      "editor/context": [
        {
          "command": "ipynb-pdf-converter.convertToPdf",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@98"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfWithPassword",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@99"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfHossam",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@100"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfHossamWithPassword",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@101"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfJussam",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@102"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfJussamWithPassword",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.ipynb-pdf-converter.teacherMode",
          "group": "navigation@103"
        }
      ],
      "notebook/cell/title": [
        {
          "command": "ipynb-pdf-converter.convertToPdf",
          "when": "notebookType == jupyter-notebook",
          "group": "z_convert@98"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfWithPassword",
          "when": "notebookType == jupyter-notebook",
          "group": "z_convert@99"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfHossam",
          "when": "notebookType == jupyter-notebook && config.ipynb-pdf-converter.teacherMode",
          "group": "z_convert@100"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfHossamWithPassword",
          "when": "notebookType == jupyter-notebook && config.ipynb-pdf-converter.teacherMode",
          "group": "z_convert@101"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfJussam",
          "when": "notebookType == jupyter-notebook && config.ipynb-pdf-converter.teacherMode",
          "group": "z_convert@102"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfJussamWithPassword",
          "when": "notebookType == jupyter-notebook && config.ipynb-pdf-converter.teacherMode",
          "group": "z_convert@103"
        }
      ],
      "commandPalette": [
        {
          "command": "ipynb-pdf-converter.convertToPdf",
          "when": "resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook'"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfWithPassword",
          "when": "resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook'"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfHossam",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook') && config.ipynb-pdf-converter.teacherMode"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfHossamWithPassword",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook') && config.ipynb-pdf-converter.teacherMode"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfJussam",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook') && config.ipynb-pdf-converter.teacherMode"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfJussamWithPassword",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook') && config.ipynb-pdf-converter.teacherMode"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "ipynb-pdf-converter.pdfTheme": {
          "type": "string",
          "default": "light",
          "enum": [
            "default",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "%config.pdfTheme.enum.0%",
            "%config.pdfTheme.enum.1%",
            "%config.pdfTheme.enum.2%"
          ],
          "description": "%config.pdfTheme.description%"
        },
        "ipynb-pdf-converter.codeTheme": {
          "type": "string",
          "default": "mdr-dark",
          "enum": [
            "mdr-dark",
            "mdr-light",
            "dracula",
            "github",
            "github-dark",
            "atom-one-light",
            "atom-one-dark",
            "monokai",
            "nord",
            "vs2015",
            "leekh"
          ],
          "enumDescriptions": [
            "%config.codeTheme.enum.0%",
            "%config.codeTheme.enum.1%",
            "%config.codeTheme.enum.2%",
            "%config.codeTheme.enum.3%",
            "%config.codeTheme.enum.4%",
            "%config.codeTheme.enum.5%",
            "%config.codeTheme.enum.6%",
            "%config.codeTheme.enum.7%",
            "%config.codeTheme.enum.8%",
            "%config.codeTheme.enum.9%",
            "%config.codeTheme.enum.10%"
          ],
          "description": "%config.codeTheme.description%"
        },
        "ipynb-pdf-converter.pdfPageSize": {
          "type": "string",
          "default": "A4",
          "enum": [
            "A3",
            "A4",
            "A5",
            "B4",
            "B5",
            "Letter",
            "Legal",
            "Widescreen",
            "iPadPro13",
            "iPadPro11",
            "iPadAir13",
            "iPad11",
            "iPadMini",
            "GalaxyTabS11",
            "GalaxyTabS11Ultra"
          ],
          "enumDescriptions": [
            "%config.pdfPageSize.enum.0%",
            "%config.pdfPageSize.enum.1%",
            "%config.pdfPageSize.enum.2%",
            "%config.pdfPageSize.enum.3%",
            "%config.pdfPageSize.enum.4%",
            "%config.pdfPageSize.enum.5%",
            "%config.pdfPageSize.enum.6%",
            "%config.pdfPageSize.enum.7%",
            "%config.pdfPageSize.enum.8%",
            "%config.pdfPageSize.enum.9%",
            "%config.pdfPageSize.enum.10%",
            "%config.pdfPageSize.enum.11%",
            "%config.pdfPageSize.enum.12%",
            "%config.pdfPageSize.enum.13%",
            "%config.pdfPageSize.enum.14%"
          ],
          "description": "%config.pdfPageSize.description%"
        },
        "ipynb-pdf-converter.pdfPageOrientation": {
          "type": "string",
          "default": "portrait",
          "enum": [
            "portrait",
            "landscape"
          ],
          "description": "%config.pdfPageOrientation.description%"
        },
        "ipynb-pdf-converter.pdfPageMargin": {
          "type": "number",
          "default": 48,
          "minimum": 0,
          "maximum": 200,
          "description": "%config.pdfPageMargin.description%"
        },
        "ipynb-pdf-converter.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "%config.outputDirectory.description%"
        },
        "ipynb-pdf-converter.outputFileName": {
          "type": "string",
          "default": "{name}",
          "description": "%config.outputFileName.description%"
        },
        "ipynb-pdf-converter.openAfterConvert": {
          "type": "boolean",
          "default": false,
          "description": "%config.openAfterConvert.description%"
        },
        "ipynb-pdf-converter.headerText": {
          "type": "string",
          "default": "{file}",
          "description": "%config.headerText.description%"
        },
        "ipynb-pdf-converter.footerText": {
          "type": "string",
          "default": "{page} / {total}",
          "description": "%config.footerText.description%"
        },
        "ipynb-pdf-converter.headerAlign": {
          "type": "string",
          "default": "right",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "description": "%config.headerAlign.description%"
        },
        "ipynb-pdf-converter.footerAlign": {
          "type": "string",
          "default": "right",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "description": "%config.footerAlign.description%"
        },
        "ipynb-pdf-converter.headerFooterFontSize": {
          "type": "number",
          "default": 10,
          "minimum": 6,
          "maximum": 24,
          "description": "%config.headerFooterFontSize.description%"
        },
        "ipynb-pdf-converter.pageBreakBefore": {
          "type": "string",
          "default": "none",
          "enum": [
            "h1",
            "h1-h2",
            "none"
          ],
          "enumDescriptions": [
            "%config.pageBreakBefore.enum.0%",
            "%config.pageBreakBefore.enum.1%",
            "%config.pageBreakBefore.enum.2%"
          ],
          "description": "%config.pageBreakBefore.description%"
        },
        "ipynb-pdf-converter.breakBeforeTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.breakBeforeTags.description%"
        },
        "ipynb-pdf-converter.hideCodeCells": {
          "type": "boolean",
          "default": false,
          "description": "%config.hideCodeCells.description%"
        },
        "ipynb-pdf-converter.hideOutputs": {
          "type": "boolean",
          "default": false,
          "description": "%config.hideOutputs.description%"
        },
        "ipynb-pdf-converter.excludeCellTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.excludeCellTags.description%"
        },
        "ipynb-pdf-converter.tableNowrap": {
          "type": "string",
          "default": "first",
          "enum": [
            "first",
            "all",
            "none"
          ],
          "enumDescriptions": [
            "%config.tableNowrap.enum.0%",
            "%config.tableNowrap.enum.1%",
            "%config.tableNowrap.enum.2%"
          ],
          "description": "%config.tableNowrap.description%"
        },
        "ipynb-pdf-converter.showLineNumbers": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "%config.showLineNumbers.enum.0%",
            "%config.showLineNumbers.enum.1%",
            "%config.showLineNumbers.enum.2%"
          ],
          "description": "%config.showLineNumbers.description%"
        },
        "ipynb-pdf-converter.baseFontSize": {
          "type": "number",
          "default": 16,
          "minimum": 8,
          "maximum": 32,
          "description": "%config.baseFontSize.description%"
        },
        "ipynb-pdf-converter.bodyFontFamily": {
          "type": "string",
          "default": "",
          "description": "%config.bodyFontFamily.description%"
        },
        "ipynb-pdf-converter.codeFontFamily": {
          "type": "string",
          "default": "",
          "description": "%config.codeFontFamily.description%"
        },
        "ipynb-pdf-converter.imageFormat": {
          "type": "string",
          "default": "png",
          "enum": [
            "png",
            "jpeg"
          ],
          "enumDescriptions": [
            "%config.imageFormat.enum.0%",
            "%config.imageFormat.enum.1%"
          ],
          "description": "%config.imageFormat.description%"
        },
        "ipynb-pdf-converter.jpegQuality": {
          "type": "number",
          "default": 85,
          "minimum": 10,
          "maximum": 100,
          "description": "%config.jpegQuality.description%"
        },
        "ipynb-pdf-converter.deviceScaleFactor": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 5,
          "description": "%config.deviceScaleFactor.description%"
        },
        "ipynb-pdf-converter.pdfPassword": {
          "type": "string",
          "default": "",
          "description": "%config.pdfPassword.description%"
        },
        "ipynb-pdf-converter.pdfPermissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "print",
              "copy",
              "modify",
              "annot-forms"
            ]
          },
          "uniqueItems": true,
          "default": [
            "annot-forms"
          ],
          "description": "%config.pdfPermissions.description%"
        },
        "ipynb-pdf-converter.ownerPassword": {
          "type": "string",
          "default": "",
          "description": "%config.ownerPassword.description%"
        },
        "ipynb-pdf-converter.coverPage": {
          "type": "boolean",
          "default": false,
          "description": "%config.coverPage.description%"
        },
        "ipynb-pdf-converter.coverTitle": {
          "type": "string",
          "default": "{file}",
          "description": "%config.coverTitle.description%"
        },
        "ipynb-pdf-converter.coverSubtitle": {
          "type": "string",
          "default": "",
          "description": "%config.coverSubtitle.description%"
        },
        "ipynb-pdf-converter.coverAuthor": {
          "type": "string",
          "default": "",
          "description": "%config.coverAuthor.description%"
        },
        "ipynb-pdf-converter.watermarkImage": {
          "type": "string",
          "default": "",
          "description": "%config.watermarkImage.description%"
        },
        "ipynb-pdf-converter.watermarkWidth": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 2000,
          "description": "%config.watermarkWidth.description%"
        },
        "ipynb-pdf-converter.allowRemoteImages": {
          "type": "boolean",
          "default": true,
          "description": "%config.allowRemoteImages.description%"
        },
        "ipynb-pdf-converter.renderTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 600,
          "description": "%config.renderTimeoutSeconds.description%"
        },
        "ipynb-pdf-converter.teacherMode": {
          "type": "boolean",
          "default": false,
          "description": "%config.teacherMode.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run vendor && npm run typecheck && npm run build",
    "vendor": "node scripts/vendor.mjs",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --platform=node --target=node18 --external:vscode --format=cjs --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --platform=node --target=node18 --external:vscode --format=cjs --sourcemap --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "pretest": "npm run typecheck && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.4.2",
    "@types/vscode": "^1.84.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "@vscode/test-electron": "^2.3.3",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.45.0",
    "github-markdown-css": "^5.9.0",
    "glob": "^10.3.3",
    "html2canvas": "^1.4.1",
    "mocha": "^10.2.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "jspdf": "^2.5.1",
    "marked": "^12.0.0"
  }
}
