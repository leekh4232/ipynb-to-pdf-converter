{
  "name": "ipynb-pdf-converter",
  "displayName": "Ipynb PDF Converter",
  "description": "Convert Jupyter Notebook (.ipynb) and Markdown (.md) files to paginated PDF documents on standard paper sizes (A4, A3, B5, …) with light/dark page themes and optional password protection.",
  "version": "0.7.0",
  "publisher": "leekh",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekh4232/ipynb-to-png-converter"
  },
  "author": {
    "name": "이광호",
    "email": "leekh4232@gmail.com"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ipynb-pdf-converter.convertToPdf",
        "title": "Convert Notebook/Markdown to PDF",
        "category": "Jupyter"
      },
      {
        "command": "ipynb-pdf-converter.convertToPdfWithPassword",
        "title": "Convert Notebook/Markdown to PDF (with Password)",
        "category": "Jupyter"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "ipynb-pdf-converter.convertToPdf",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@98"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfWithPassword",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@99"
        }
      ],
      "editor/title/context": [
        {
          "command": "ipynb-pdf-converter.convertToPdf",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@98"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfWithPassword",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "ipynb-pdf-converter.convertToPdf",
          "when": "resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook'"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfWithPassword",
          "when": "resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook'"
        }
      ]
    },
    "configuration": {
      "title": "Ipynb PDF Converter",
      "properties": {
        "ipynb-pdf-converter.deviceScaleFactor": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 5,
          "description": "Rendering scale factor for PDF resolution (1-5). Higher values produce sharper pages."
        },
        "ipynb-pdf-converter.pdfPageSize": {
          "type": "string",
          "default": "A4",
          "enum": [
            "A3",
            "A4",
            "A5",
            "B4",
            "B5",
            "Letter",
            "Legal",
            "Widescreen"
          ],
          "enumDescriptions": [
            "A3 (297 × 420 mm)",
            "A4 (210 × 297 mm)",
            "A5 (148 × 210 mm)",
            "B4 (JIS, 257 × 364 mm)",
            "B5 (JIS, 182 × 257 mm)",
            "Letter (8.5 × 11 in)",
            "Legal (8.5 × 14 in)",
            "Widescreen 16:9 slide (13.333 × 7.5 in, nb_convert.py horizontal mode; use with landscape orientation)"
          ],
          "description": "Paper size of each PDF page. Content is laid out at 96 dpi (A4 portrait ≈ 794 × 1123 CSS px) and split across pages."
        },
        "ipynb-pdf-converter.pdfPageOrientation": {
          "type": "string",
          "default": "portrait",
          "enum": [
            "portrait",
            "landscape"
          ],
          "description": "Page orientation."
        },
        "ipynb-pdf-converter.pdfPageMargin": {
          "type": "number",
          "default": 48,
          "minimum": 0,
          "maximum": 200,
          "description": "Page margin on all four sides, in CSS pixels (48 px = 0.5 in, nb_convert.py's @page margin). The Markdown Reader page themes add the script's 30 px body margin inside it: on both sides of every page, and above/below the document on the first/last page."
        },
        "ipynb-pdf-converter.pdfTheme": {
          "type": "string",
          "default": "light",
          "enum": [
            "default",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Default: GitHub document style (github-markdown.css)",
            "Light: Markdown Reader light palette (nb_convert.py --theme light)",
            "Dark: Markdown Reader dark palette (nb_convert.py --theme dark)"
          ],
          "description": "Overall page theme (paper, text, headings, tables, outputs), ported from nb_convert.py. Code cells always use 'codeTheme'. The 'leekh' chrome (emoji headings) applies only with 'default'."
        },
        "ipynb-pdf-converter.codeTheme": {
          "type": "string",
          "default": "mdr-dark",
          "enum": [
            "mdr-dark",
            "mdr-light",
            "dracula",
            "github",
            "github-dark",
            "atom-one-light",
            "atom-one-dark",
            "monokai",
            "nord",
            "vs2015",
            "leekh"
          ],
          "enumDescriptions": [
            "Markdown Reader Dark (nb_convert.py --code-theme dark)",
            "Markdown Reader Light (nb_convert.py --code-theme light)",
            "Dracula",
            "GitHub Light",
            "GitHub Dark",
            "Atom One Light",
            "Atom One Dark",
            "Monokai",
            "Nord",
            "Visual Studio Dark",
            "Leekh (vertical/A4 print style: emoji headings, colored sections, accented outputs)"
          ],
          "description": "Syntax highlighting theme for source code cells. 'leekh' also restyles headings, tables, and outputs to match the A4 print layout when pdfTheme is 'default'."
        },
        "ipynb-pdf-converter.pdfPassword": {
          "type": "string",
          "default": "",
          "description": "Default password for 'Convert Notebook/Markdown to PDF (with Password)'. Leave empty to be prompted each time. The plain convert command never applies it. Stored in plain text in settings; encryption is 40-bit RC4 (jsPDF), which deters casual opening but is not strong protection."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run vendor && npm run typecheck && npm run build",
    "vendor": "node scripts/vendor.mjs",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --platform=node --target=node18 --external:vscode --format=cjs --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --platform=node --target=node18 --external:vscode --format=cjs --sourcemap --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "pretest": "npm run typecheck && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.4.2",
    "@types/vscode": "^1.84.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "@vscode/test-electron": "^2.3.3",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.45.0",
    "github-markdown-css": "^5.9.0",
    "glob": "^10.3.3",
    "html2canvas": "^1.4.1",
    "mocha": "^10.2.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "jspdf": "^2.5.1",
    "marked": "^12.0.0"
  }
}
